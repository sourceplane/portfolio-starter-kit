    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sugar-high": "^0.6.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.27.0",
    "postcss": "^8.4.35",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
