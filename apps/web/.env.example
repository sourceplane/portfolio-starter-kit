# Optional. The site's public origin (sitemap, RSS, OG and JSON-LD links);
# the Orun build sets it to the environment's Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Cloudflare Web Analytics beacon token (stands in for Vercel
# Analytics / Speed Insights). Unset → no script is rendered.
NEXT_PUBLIC_CF_BEACON_TOKEN=
